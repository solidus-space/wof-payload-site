# A generated secret for Payload (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=

# Public URL of the site (used for auth cookies / CORS)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Postgres connection string (docker-compose default below)
DATABASE_URL=postgres://payload:payload@localhost:5432/payload

# S3-compatible storage
# Local (Minio via docker-compose):
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wof-payload
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Production (Backblaze B2 example):
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_BUCKET=<your-bucket>
# S3_ACCESS_KEY_ID=<keyID>
# S3_SECRET_ACCESS_KEY=<applicationKey>
# S3_REGION=eu-central-003
# S3_FORCE_PATH_STYLE=false
